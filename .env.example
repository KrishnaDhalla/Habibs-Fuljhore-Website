# The salon's billing database (Habibs POS, Supabase): the same project as the billing app.
# Supabase → Project Settings → API → Project URL and the "anon public" (publishable) key.
# Only ever the public key here: the website can only call web_site(), request_booking() and request_enquiry().
# Never put the service_role / secret key in the website.
# Copy this file to .env, fill it in, then rebuild (on Cloudflare/Vercel/Netlify set them as build environment variables).
# Left empty, the site shows the menu saved in src/data/menu-snapshot.json and bookings/questions go by WhatsApp only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The website's own address once the domain is live, e.g. https://habibsfuljhore.in (no slash at the end).
# Used at build time for canonical links, link-preview images and sitemap.xml (better Google results).
SITE_URL=
